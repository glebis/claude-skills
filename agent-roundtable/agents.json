{
  "_comment": "Agent registry. transport = default transport (acp | headless). acp = command that speaks ACP over stdio. headless = CLI adapter with native resume: start runs a new CLI session, resume continues it by id. Placeholders: {out} temp file for the final message, {cwd} target dir, {session} native session id, {promptFile} file holding the prompt. The prompt never goes through argv: input is stdin (default) or file. output = codex-jsonl | json | text (text cannot resume). authMethod is sent with ACP authenticate when session/new fails with the auth-required code and the agent advertises that method.",
  "codex": {
    "label": "Codex",
    "transport": "headless",
    "acp": ["codex-acp"],
    "headless": {
      "start": ["codex", "exec", "--json", "--skip-git-repo-check", "--sandbox", "read-only", "-C", "{cwd}", "-o", "{out}", "-"],
      "resume": ["codex", "exec", "resume", "--json", "--skip-git-repo-check", "-c", "sandbox_mode=\"read-only\"", "-o", "{out}", "{session}", "-"],
      "input": "stdin",
      "output": "codex-jsonl"
    }
  },
  "cmd": {
    "label": "Command Code",
    "transport": "acp",
    "acp": ["cmd", "acp"],
    "headless": {
      "start": ["cmd", "-p", "--output-format", "json", "--permission-mode", "plan", "--trust", "--skip-onboarding", "--max-turns", "60"],
      "resume": ["cmd", "-p", "--output-format", "json", "--permission-mode", "plan", "--trust", "--skip-onboarding", "--max-turns", "60", "--resume", "{session}"],
      "input": "stdin",
      "output": "json"
    }
  },
  "gemini": {
    "label": "Gemini CLI",
    "transport": "acp",
    "acp": ["gemini", "--experimental-acp"],
    "authMethod": "oauth-personal"
  },
  "opencode": {
    "label": "OpenCode",
    "transport": "acp",
    "acp": ["opencode", "acp"]
  },
  "claude": {
    "label": "Claude Code",
    "transport": "acp",
    "acp": ["claude-agent-acp"],
    "headless": {
      "start": ["claude", "-p", "--output-format", "json", "--permission-mode", "plan"],
      "resume": ["claude", "-p", "--output-format", "json", "--permission-mode", "plan", "--resume", "{session}"],
      "input": "stdin",
      "output": "json"
    }
  }
}
